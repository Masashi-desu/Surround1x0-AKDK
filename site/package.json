{
  "name": "surround1x0-akdk-preview",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "model:pcb": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background ../3d-preview/Surround1x0-AKDK.blend --python-exit-code 1 --python ../3d-preview/scripts/build_pcb_from_repository.py",
    "model:socket": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background ../3d-preview/Surround1x0-AKDK.blend --python-exit-code 1 --python ../3d-preview/scripts/build_choc_hotswap_sockets.py",
    "model:controller": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background ../3d-preview/Surround1x0-AKDK.blend --python-exit-code 1 --python ../3d-preview/scripts/build_controller_sensor_modules.py",
    "model:verify:pcb": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background ../3d-preview/Surround1x0-AKDK.blend --python-exit-code 1 --python ../3d-preview/scripts/verify_pcb_holes.py",
    "model:verify:socket": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background ../3d-preview/Surround1x0-AKDK.blend --python-exit-code 1 --python ../3d-preview/scripts/verify_choc_hotswap_sockets.py",
    "model:verify:controller": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background ../3d-preview/Surround1x0-AKDK.blend --python-exit-code 1 --python ../3d-preview/scripts/verify_controller_sensor_modules.py",
    "model:sync": "npm run model:pcb && npm run model:export",
    "model:export": "\"/Applications/Blender.app/Contents/MacOS/Blender\" --background ../3d-preview/Surround1x0-AKDK.blend --python-exit-code 1 --python ../3d-preview/scripts/export_web_glb.py"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "vite": "^8.2.1"
  }
}
